# Banco de dados — PostgreSQL (Neon), usado tanto em desenvolvimento
# quanto em produção. DATABASE_URL é a connection string "pooled"
# (com -pooler, usada em runtime); DIRECT_URL é a conexão direta,
# usada só por `prisma migrate deploy`/`migrate dev` (ver docs/DEPLOY.md).
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.regiao.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@ep-exemplo.regiao.aws.neon.tech/neondb?sslmode=require"

# URL pública do site (usada em metadata, sitemap, OG)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Analytics
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_CLARITY_ID=""

# Verificação de propriedade no Google Search Console (código de
# "meta tag HTML", não o arquivo — https://search.google.com/search-console)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Monitoramento de erros (Sentry) — opcional, ver docs/DEPLOY.md
NEXT_PUBLIC_SENTRY_DSN=""

# E-mail transacional/marketing
RESEND_API_KEY=""
