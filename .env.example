# Banco de dados — SQLite em desenvolvimento local (arquivo único, zero
# setup). Em produção: PostgreSQL (Supabase, Neon, etc.) — troque o
# provider em prisma/schema.prisma para "postgresql" e esta URL para a
# de produção; nenhum model precisa mudar (ver schema.prisma, cabeçalho).
DATABASE_URL="file:./dev.db"

# URL pública do site (usada em metadata, sitemap, OG)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Analytics
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_CLARITY_ID=""

# E-mail transacional/marketing
RESEND_API_KEY=""
